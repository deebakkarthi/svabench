// sockit_owm

assert property (@(posedge clk) bus_irq == (irq_ena & irq_sts));
assert property (@(posedge clk) owr_e == (owr_oen << owr_sel));
assert property (@(posedge clk) owr_p == owr_pwr);
assert property (@(posedge clk) owr_iln == owr_i[owr_sel]);
assert property (@(posedge clk) pls == (div == (owr_ovd ? cdr_o : cdr_n)));
assert property (@(posedge clk) req_ovd == (OVD_E ? (bus_wen_ctl_sts & bus_wdt[2]) : 1'b0));
assert property (@(posedge clk) bus_wen_ctl_sts |=> irq_ena == $past(bus_wdt[7]));
assert property (@(posedge clk) !bus_wen_ctl_sts |=> irq_ena == $past(irq_ena));
assert property (@(posedge clk) bus_wen_ctl_sts |=> irq_sts == 1'b0);
assert property (@(posedge clk) !bus_wen_ctl_sts & bus_ren_ctl_sts |=> irq_sts == 1'b0);
assert property (@(posedge clk) !bus_wen_ctl_sts & !bus_ren_ctl_sts & pls & (cnt == t_zero) |=> irq_sts == 1'b1);
assert property (@(posedge clk) !bus_wen_ctl_sts & !bus_ren_ctl_sts & !(pls & (cnt == t_zero)) |=> irq_sts == $past(irq_sts));
assert property (@(posedge clk) bus_wen_ctl_sts |=> owr_ovd == (OVD_E ? $past(bus_wdt[2]) : 1'b0));
assert property (@(posedge clk) !bus_wen_ctl_sts |=> owr_ovd == $past(owr_ovd));
assert property (@(posedge clk) bus_wen_ctl_sts |=> owr_rst == $past(bus_wdt[1]));
assert property (@(posedge clk) !bus_wen_ctl_sts |=> owr_rst == $past(owr_rst));
assert property (@(posedge clk) bus_wen_ctl_sts |=> owr_dat == $past(bus_wdt[0]));
assert property (@(posedge clk) !bus_wen_ctl_sts & pls & (cnt == t_zero) |=> owr_dat == $past(owr_smp));
assert property (@(posedge clk) !bus_wen_ctl_sts & !(pls & (cnt == t_zero)) |=> owr_dat == $past(owr_dat));
assert property (@(posedge clk) bus_wen_ctl_sts |=> owr_cyc == ($past(bus_wdt[3]) & ~&$past(bus_wdt[2:0])));
assert property (@(posedge clk) !bus_wen_ctl_sts & pls & (cnt == t_zero) |=> owr_cyc == 1'b0);
assert property (@(posedge clk) !bus_wen_ctl_sts & !(pls & (cnt == t_zero)) |=> owr_cyc == $past(owr_cyc));
assert property (@(posedge clk) bus_wen_ctl_sts |=> cnt == ($past(&bus_wdt[1:0]) ? t_idl : $past(bus_wdt[1]) ? t_rst : t_bit) - 'd1);
assert property (@(posedge clk) !bus_wen_ctl_sts & pls |=> cnt == $past(cnt) - 'd1);
assert property (@(posedge clk) !bus_wen_ctl_sts & !pls |=> cnt == $past(cnt));
assert property (@(posedge clk) bus_wen |=> div == 'd0);
assert property (@(posedge clk) !bus_wen & pls |=> div == 'd0);
assert property (@(posedge clk) !bus_wen & !pls |=> div == $past(div) + $past(owr_cyc));
assert property (@(posedge clk) (CDR_E && bus_wen_cdr_n) |=> cdr_n == $past(bus_wdt[(BDW==32 ? 15 : 7) : (BDW==32 ? 0 : 0)]));
assert property (@(posedge clk) (!CDR_E || !bus_wen_cdr_n) |=> cdr_n == $past(cdr_n));
assert property (@(posedge clk) (CDR_E && bus_wen_cdr_o) |=> cdr_o == $past(bus_wdt[(BDW==32 ? 31 : 7) : (BDW==32 ? 16 : 0)]));
assert property (@(posedge clk) (!CDR_E || !bus_wen_cdr_o) |=> cdr_o == $past(cdr_o));
assert property (@(posedge clk) bus_wen_pwr_sel |=> owr_pwr == $past(bus_wdt[(BDW==32 ? 16 : 4)+:OWN]));
assert property (@(posedge clk) !bus_wen_pwr_sel |=> owr_pwr == $past(owr_pwr));
assert property (@(posedge clk) (OWN > 1 && bus_wen_pwr_sel) |=> owr_sel == $past(bus_wdt[(BDW==32 ? 8 : 0)+:SDW]));
assert property (@(posedge clk) (OWN > 1 && !bus_wen_pwr_sel) |=> owr_sel == $past(owr_sel));
assert property (@(posedge clk) bus_wen_ctl_sts |=> owr_oen == ~&$past(bus_wdt[1:0]));
assert property (@(posedge clk) !bus_wen_ctl_sts & pls & (owr_rst & (cnt == t_rsth)) |=> owr_oen == 1'b0);
assert property (@(posedge clk) !bus_wen_ctl_sts & pls & !(owr_rst & (cnt == t_rsth)) & (owr_dat & (cnt == t_dat1)) |=> owr_oen == 1'b0);
assert property (@(posedge clk) !bus_wen_ctl_sts & pls & !(owr_rst & (cnt == t_rsth)) & !(owr_dat & (cnt == t_dat1)) & (cnt == t_dat0) |=> owr_oen == 1'b0);
assert property (@(posedge clk) !bus_wen_ctl_sts & pls & !(owr_rst & (cnt == t_rsth)) & !(owr_dat & (cnt == t_dat1)) & !(cnt == t_dat0) |=> owr_oen == $past(owr_oen));
assert property (@(posedge clk) !bus_wen_ctl_sts & !pls |=> owr_oen == $past(owr_oen));
assert property (@(posedge clk) pls & (owr_rst & (cnt == t_rstp)) |=> owr_smp == $past(owr_iln));
assert property (@(posedge clk) pls & !(owr_rst & (cnt == t_rstp)) & (~owr_rst & (cnt == t_bits)) |=> owr_smp == $past(owr_iln));
assert property (@(posedge clk) pls & !(owr_rst & (cnt == t_rstp)) & !(~owr_rst & (cnt == t_bits)) |=> owr_smp == $past(owr_smp));
assert property (@(posedge clk) !pls |=> owr_smp == $past(owr_smp));

// sockit_owm
assert property (@(posedge clk) bus_irq == (irq_ena & irq_sts));
assert property (@(posedge clk) owr_p == owr_pwr);
assert property (@(posedge clk) owr_e == (owr_oen << owr_sel));
assert property (@(posedge clk) owr_iln == owr_i[owr_sel]);
assert property (@(posedge clk) pls == (div == (owr_ovd ? cdr_o : cdr_n)));
assert property (@(posedge clk) (bus_adr[0] == 1'b0) |-> bus_rdt == {24'h000000, irq_ena, irq_sts, 1'b0, owr_pwr[0], owr_cyc, owr_ovd, owr_rst, owr_dat});
assert property (@(posedge clk) (bus_adr[0] == 1'b1) |-> bus_rdt == {cdr_o, cdr_n});
assert property (@(posedge clk) rst |-> (div == '0 && cnt == '0 && !owr_cyc && !irq_ena && !irq_sts && !owr_ovd && !owr_rst && !owr_dat && !owr_oen && owr_pwr == '0 && cdr_n == 16'd4 && cdr_o == 16'd0));

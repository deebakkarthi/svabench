generate
  for(y=0; y<5; y=y+1) begin
    for(x=0; x<5; x=x+1) begin
      assert property (@(*) (ff[x][y] == (ee[x][y] ^ ((~ee[(x==4?0:x+1)][y]) & ee[(x==3?0:(x==4?1:x+2))][y])))));
    end
  end
endgenerate

generate
  for(x=0; x<64; x=x+1) begin
    if(x==0 || x==1 || x==3 || x==7 || x==15 || x==31 || x==63)
      assert property (@(*) (gg[0][0][x] == (ff[0][0][x] ^ round_const_2[x])));
    else
      assert property (@(*) (gg[0][0][x] == ff[0][0][x]));
  end
endgenerate

generate
  for(y=0; y<5; y=y+1) begin
    for(x=0; x<5; x=x+1) begin
      if(!(x==0 && y==0))
        assert property (@(*) (gg[x][y] == ff[x][y]));
    end
  end
endgenerate

generate
  for(y=0; y<5; y=y+1) begin
    for(x=0; x<5; x=x+1) begin
      assert property (@(*) (out[(1599-64*(5*y+x)):(1536-64*(5*y+x))] == gg[x][y]));
    end
  end
endgenerate

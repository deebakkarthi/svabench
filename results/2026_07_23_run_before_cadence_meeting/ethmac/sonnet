module eth_clockgen_assert (Clk, Reset, Divider, MdcEn, MdcEn_n, Mdc);
input       Clk;
input       Reset;
input [7:0] Divider;
input       Mdc;
input       MdcEn;
input       MdcEn_n;

assert property (@(posedge Clk)
  eth_clockgen.TempDivider == ((Divider<2) ? 8'h02 : Divider));

assert property (@(posedge Clk)
  eth_clockgen.CounterPreset == ((eth_clockgen.TempDivider>>1) - 8'b1));

assert property (@(posedge Clk)
  eth_clockgen.CountEq0 == (eth_clockgen.Counter == 8'h0));

assert property (@(posedge Clk)
  MdcEn == (eth_clockgen.CountEq0 & ~Mdc));

assert property (@(posedge Clk)
  MdcEn_n == (eth_clockgen.CountEq0 & Mdc));

assert property (@(posedge Clk)
  Reset |=> eth_clockgen.Counter == 8'h1);

assert property (@(posedge Clk) disable iff (Reset)
  eth_clockgen.CountEq0 |=> eth_clockgen.Counter == $past(eth_clockgen.CounterPreset));

assert property (@(posedge Clk) disable iff (Reset)
  !eth_clockgen.CountEq0 |=> eth_clockgen.Counter == ($past(eth_clockgen.Counter) - 8'h1));

assert property (@(posedge Clk)
  Reset |=> Mdc == 1'b0);

assert property (@(posedge Clk) disable iff (Reset)
  $past(eth_clockgen.CountEq0) |=> Mdc == ~$past(Mdc));
endmodule



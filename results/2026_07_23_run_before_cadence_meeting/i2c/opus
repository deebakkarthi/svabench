// i2c_master_bit_ctrl
assert property (@(posedge clk) scl_o == 1'b0);
assert property (@(posedge clk) sda_o == 1'b0);
assert property (@(posedge clk) slave_reset == (sta_condition | sto_condition));
assert property (@(posedge clk) sda_oen == (master_mode ? sda_oen_master : sda_oen_slave));
assert property (@(posedge clk) scl_oen == (master_mode ? scl_oen_master : scl_oen_slave));
assert property (@(posedge clk) 1 |=> dscl_oen == $past(scl_oen));
assert property (@(posedge clk) disable iff(!nReset) (rst) |=> busy == 1'b0);
assert property (@(posedge clk) disable iff(!nReset) !rst |=> busy == (($past(sta_condition) | $past(busy)) & ~$past(sto_condition)));
assert property (@(posedge clk) disable iff(!nReset) !rst |=> sta_condition == (~$past(sSDA) & $past(dSDA) & $past(sSCL)));
assert property (@(posedge clk) disable iff(!nReset) !rst |=> sto_condition == ($past(sSDA) & ~$past(dSDA) & $past(sSCL)));
assert property (@(posedge clk) disable iff(!nReset) !rst |=> sSCL == (&$past(fSCL[2:1]) | &$past(fSCL[1:0]) | ($past(fSCL[2]) & $past(fSCL[0]))));
assert property (@(posedge clk) disable iff(!nReset) !rst |=> cSCL == {$past(cSCL[0]),$past(scl_i)});
assert property (@(posedge clk) disable iff(!nReset) !rst |=> cSDA == {$past(cSDA[0]),$past(sda_i)});
assert property (@(posedge clk) disable iff(!nReset) !rst |=> al == (($past(sda_chk) & ~$past(sSDA) & $past(sda_oen)) | (|$past(c_state) & $past(sto_condition) & ~$past(cmd_stop))));
assert property (@(posedge clk) disable iff(!nReset) !rst |=> slave_wait == (($past(scl_oen) & ~$past(dscl_oen) & ~$past(sSCL)) | ($past(slave_wait) & ~$past(sSCL))));
assert property (@(posedge clk) disable iff(!nReset) (rst || ~|cnt || !ena || scl_sync) |=> cnt == $past(clk_cnt) && clk_en == 1'b1);
assert property (@(posedge clk) disable iff(!nReset) (!rst && |cnt && ena && !scl_sync && slave_wait) |=> cnt == $past(cnt) && clk_en == 1'b0);
assert property (@(posedge clk) disable iff(!nReset) (!rst && |cnt && ena && !scl_sync && !slave_wait) |=> cnt == ($past(cnt)-16'h1) && clk_en == 1'b0);
assert property (@(posedge clk) disable iff(!nReset) (rst | al) |=> c_state == idle && cmd_ack == 1'b0 && scl_oen_master && sda_oen_master && !sda_chk);
assert property (@(posedge clk) disable iff(!nReset) (!(rst|al) && !clk_en) |=> cmd_ack == 1'b0);
assert property (@(posedge clk) disable iff(!nReset) (!(rst|al) && clk_en && c_state==start_a) |=> c_state==start_b);
assert property (@(posedge clk) disable iff(!nReset) (!(rst|al) && clk_en && c_state==start_b) |=> c_state==start_c);
assert property (@(posedge clk) disable iff(!nReset) (!(rst|al) && clk_en && c_state==start_c) |=> c_state==start_d);
assert property (@(posedge clk) disable iff(!nReset) (!(rst|al) && clk_en && c_state==start_d) |=> c_state==start_e);
assert property (@(posedge clk) disable iff(!nReset) (!(rst|al) && clk_en && c_state==start_e) |=> c_state==idle && cmd_ack==1'b1);
assert property (@(posedge clk) disable iff(!nReset) (!(rst|al) && clk_en && c_state==stop_d) |=> c_state==idle && cmd_ack==1'b1);
assert property (@(posedge clk) disable iff(!nReset) (!(rst|al) && clk_en && c_state==rd_d) |=> c_state==idle && cmd_ack==1'b1);
assert property (@(posedge clk) disable iff(!nReset) (!(rst|al) && clk_en && c_state==wr_d) |=> c_state==idle && cmd_ack==1'b1);
assert property (@(posedge clk) disable iff(!nReset) (!rst && !clk_en) |=> cmd_stop == $past(cmd_stop));
assert property (@(posedge clk) (!($past(sSCL) & ~$past(dSCL))) |=> dout == $past(dout));
assert property (@(posedge clk) disable iff(!nReset) (rst | sta_condition || !ena) |=> slave_state==slave_idle && cmd_slave_ack==1'b0 && sda_oen_slave && scl_oen_slave);
assert property (@(posedge clk) disable iff(!nReset) (!(rst|sta_condition||!ena) && $past(sl_wait)) |=> scl_oen_slave==1'b0);
assert property (@(posedge clk) disable iff(!nReset) (!(rst|sta_condition||!ena) && !$past(sl_wait)) |=> scl_oen_slave==1'b1);
assert property (@(posedge clk) disable iff(!nReset) sta_condition |=> slave_cnt==4'h8 && slave_adr==8'h0 && slave_adr_received==1'b0);

// i2c_master_byte_ctrl
assert property (@(posedge clk) dout == sr);
assert property (@(posedge clk) go == ((read | write | stop) & ~cmd_ack));
assert property (@(posedge clk) cnt_done == ~(|dcnt));
assert property (@(posedge clk) 1 |=> slave_adr_received_d == $past(slave_adr_received));
assert property (@(posedge clk) disable iff(!nReset) rst |=> sr == 8'h0);
assert property (@(posedge clk) disable iff(!nReset) (!rst && $past(ld)) |=> sr == $past(din));
assert property (@(posedge clk) disable iff(!nReset) (!rst && !$past(ld) && $past(shift)) |=> sr == {$past(sr[6:0]),$past(core_rxd)});
assert property (@(posedge clk) disable iff(!nReset) rst |=> dcnt == 3'h0);
assert property (@(posedge clk) disable iff(!nReset) (!rst && $past(ld)) |=> dcnt == 3'h7);
assert property (@(posedge clk) disable iff(!nReset) (!rst && !$past(ld) && $past(shift)) |=> dcnt == ($past(dcnt)-3'h1));
assert property (@(posedge clk) disable iff(!nReset) (rst | i2c_al | slave_reset) |=> c_state==ST_IDLE && core_cmd==4'b0000 && shift==1'b0 && ld==1'b0 && cmd_ack==1'b0 && master_mode==1'b0);
assert property (@(posedge clk) disable iff(!nReset) !(rst | i2c_al | slave_reset) |=> slave_cmd_out == $past(slave_cmd));
assert property (@(posedge clk) disable iff(!nReset) !(rst | i2c_al | slave_reset) |=> shift==1'b0 || $past(1'b1));
assert property (@(posedge clk) disable iff(!nReset) (!(rst|i2c_al|slave_reset) && c_state==ST_START && !core_ack) |=> c_state==ST_START);
assert property (@(posedge clk) disable iff(!nReset) (!(rst|i2c_al|slave_reset) && c_state==ST_STOP && core_ack) |=> c_state==ST_IDLE && core_cmd==4'b0000 && cmd_ack==1'b1);


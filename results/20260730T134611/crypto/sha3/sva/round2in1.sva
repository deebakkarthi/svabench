// round2in1
generate
  for(y=0; y<5; y=y+1) begin
    for(x=0; x<5; x=x+1) begin
      assert property (@(*) (a[x][y] == in[(1599-64*(5*y+x)):(1536-64*(5*y+x))]));
    end
  end
endgenerate

generate
  for(x=0; x<5; x=x+1) begin
    assert property (@(*) (b[x] == (a[x][0] ^ a[x][1] ^ a[x][2] ^ a[x][3] ^ a[x][4])));
  end
endgenerate

generate
  for(y=0; y<5; y=y+1) begin
    for(x=0; x<5; x=x+1) begin
      assert property (@(*) (c[x][y] == (a[x][y] ^ b[(x==0?4:x-1)] ^ {b[(x==4?0:x+1)][62:0], b[(x==4?0:x+1)][63]})));
    end
  end
endgenerate

assert property (@(*) (d[0][0] == c[0][0]));
assert property (@(*) (d[1][0] == {c[1][0][62:0], c[1][0][63]}));
assert property (@(*) (d[2][0] == {c[2][0][1:0], c[2][0][63:2]}));
assert property (@(*) (d[3][0] == {c[3][0][35:0], c[3][0][63:36]}));
assert property (@(*) (d[4][0] == {c[4][0][36:0], c[4][0][63:37]}));
assert property (@(*) (d[0][1] == {c[0][1][27:0], c[0][1][63:28]}));
assert property (@(*) (d[1][1] == {c[1][1][19:0], c[1][1][63:20]}));
assert property (@(*) (d[2][1] == {c[2][1][57:0], c[2][1][63:58]}));
assert property (@(*) (d[3][1] == {c[3][1][8:0], c[3][1][63:9]}));
assert property (@(*) (d[4][1] == {c[4][1][43:0], c[4][1][63:44]}));
assert property (@(*) (d[0][2] == {c[0][2][60:0], c[0][2][63:61]}));
assert property (@(*) (d[1][2] == {c[1][2][53:0], c[1][2][63:54]}));
assert property (@(*) (d[2][2] == {c[2][2][20:0], c[2][2][63:21]}));
assert property (@(*) (d[3][2] == {c[3][2][38:0], c[3][2][63:39]}));
assert property (@(*) (d[4][2] == {c[4][2][24:0], c[4][2][63:25]}));
assert property (@(*) (d[0][3] == {c[0][3][22:0], c[0][3][63:23]}));
assert property (@(*) (d[1][3] == {c[1][3][18:0], c[1][3][63:19]}));
assert property (@(*) (d[2][3] == {c[2][3][48:0], c[2][3][63:49]}));
assert property (@(*) (d[3][3] == {c[3][3][42:0], c[3][3][63:43]}));
assert property (@(*) (d[4][3] == {c[4][3][55:0], c[4][3][63:56]}));
assert property (@(*) (d[0][4] == {c[0][4][45:0], c[0][4][63:46]}));
assert property (@(*) (d[1][4] == {c[1][4][61:0], c[1][4][63:62]}));
assert property (@(*) (d[2][4] == {c[2][4][2:0], c[2][4][63:3]}));
assert property (@(*) (d[3][4] == {c[3][4][7:0], c[3][4][63:8]}));
assert property (@(*) (d[4][4] == {c[4][4][49:0], c[4][4][63:50]}));

assert property (@(*) (e[0][0] == d[0][0]));
assert property (@(*) (e[0][2] == d[1][0]));
assert property (@(*) (e[0][4] == d[2][0]));
assert property (@(*) (e[0][1] == d[3][0]));
assert property (@(*) (e[0][3] == d[4][0]));
assert property (@(*) (e[1][3] == d[0][1]));
assert property (@(*) (e[1][0] == d[1][1]));
assert property (@(*) (e[1][2] == d[2][1]));
assert property (@(*) (e[1][4] == d[3][1]));
assert property (@(*) (e[1][1] == d[4][1]));
assert property (@(*) (e[2][1] == d[0][2]));
assert property (@(*) (e[2][3] == d[1][2]));
assert property (@(*) (e[2][0] == d[2][2]));
assert property (@(*) (e[2][2] == d[3][2]));
assert property (@(*) (e[2][4] == d[4][2]));
assert property (@(*) (e[3][4] == d[0][3]));
assert property (@(*) (e[3][1] == d[1][3]));
assert property (@(*) (e[3][3] == d[2][3]));
assert property (@(*) (e[3][0] == d[3][3]));
assert property (@(*) (e[3][2] == d[4][3]));
assert property (@(*) (e[4][2] == d[0][4]));
assert property (@(*) (e[4][4] == d[1][4]));
assert property (@(*) (e[4][1] == d[2][4]));
assert property (@(*) (e[4][3] == d[3][4]));
assert property (@(*) (e[4][0] == d[4][4]));

generate
  for(y=0; y<5; y=y+1) begin
    for(x=0; x<5; x=x+1) begin
      assert property (@(*) (f[x][y] == (e[x][y] ^ ((~e[(x==4?0:x+1)][y]) & e[(x==3?0:(x==4?1:x+2))][y])))));
    end
  end
endgenerate

generate
  for(x=0; x<64; x=x+1) begin
    if(x==0 || x==1 || x==3 || x==7 || x==15 || x==31 || x==63)
      assert property (@(*) (g[0][0][x] == (f[0][0][x] ^ round_const_1[x])));
    else
      assert property (@(*) (g[0][0][x] == f[0][0][x]));
  end
endgenerate

generate
  for(y=0; y<5; y=y+1) begin
    for(x=0; x<5; x=x+1) begin
      if(!(x==0 && y==0))
        assert property (@(*) (g[x][y] == f[x][y]));
    end
  end
endgenerate

generate
  for(x=0; x<5; x=x+1) begin
    assert property (@(*) (bb[x] == (g[x][0] ^ g[x][1] ^ g[x][2] ^ g[x][3] ^ g[x][4])));
  end
endgenerate

generate
  for(y=0; y<5; y=y+1) begin
    for(x=0; x<5; x=x+1) begin
      assert property (@(*) (cc[x][y] == (g[x][y] ^ bb[(x==0?4:x-1)] ^ {bb[(x==4?0:x+1)][62:0], bb[(x==4?0:x+1)][63]})));
    end
  end
endgenerate


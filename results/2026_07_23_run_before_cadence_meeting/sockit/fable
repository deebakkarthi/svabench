assert property (@(posedge clk) disable iff (rst) (bus_wen && bus_adr[0] == 1'b0) |=> !irq_sts);
assert property (@(posedge clk) disable iff (rst) (!(bus_wen && bus_adr[0] == 1'b0) && pls && (cnt == '0)) |=> irq_sts);
assert property (@(posedge clk) disable iff (rst) (!bus_wen && bus_ren && bus_adr[0] == 1'b0 && !(pls && (cnt == '0))) |=> !irq_sts);
assert property (@(posedge clk) disable iff (rst) (!(bus_wen && bus_adr[0] == 1'b0) && !(pls && (cnt == '0)) && !(bus_ren && bus_adr[0] == 1'b0)) |=> $stable(irq_sts));
assert property (@(posedge clk) disable iff (rst) (bus_wen && bus_adr[0] == 1'b0) |=> owr_ovd == $past(bus_wdt[2]));
assert property (@(posedge clk) disable iff (rst) !(bus_wen && bus_adr[0] == 1'b0) |=> $stable(owr_ovd));
assert property (@(posedge clk) disable iff (rst) (bus_wen && bus_adr[0] == 1'b0) |=> owr_rst == $past(bus_wdt[1]));
assert property (@(posedge clk) disable iff (rst) !(bus_wen && bus_adr[0] == 1'b0) |=> $stable(owr_rst));
assert property (@(posedge clk) disable iff (rst) (bus_wen && bus_adr[0] == 1'b0) |=> owr_dat == $past(bus_wdt[0]));
assert property (@(posedge clk) disable iff (rst) (!(bus_wen && bus_adr[0] == 1'b0) && pls && (cnt == '0)) |=> owr_dat == $past(owr_smp));
assert property (@(posedge clk) disable iff (rst) (!(bus_wen && bus_adr[0] == 1'b0) && !(pls && (cnt == '0))) |=> $stable(owr_dat));
assert property (@(posedge clk) disable iff (rst) (bus_wen && bus_adr[0] == 1'b0) |=> owr_cyc == $past(bus_wdt[3] & ~&bus_wdt[2:0]));
assert property (@(posedge clk) disable iff (rst) (!(bus_wen && bus_adr[0] == 1'b0) && pls && (cnt == '0)) |=> !owr_cyc);
assert property (@(posedge clk) disable iff (rst) (!(bus_wen && bus_adr[0] == 1'b0) && !(pls && (cnt == '0))) |=> $stable(owr_cyc));
assert property (@(posedge clk) disable iff (rst) (bus_wen && bus_adr[0] == 1'b0) |=> cnt == $past((&bus_wdt[1:0]) ? (bus_wdt[2] ? 8'd95 : 8'd199) : bus_wdt[1] ? (bus_wdt[2] ? 8'd95 : 8'd191) : (bus_wdt[2] ? 8'd7 : 8'd12)));
assert property (@(posedge clk) disable iff (rst) (!(bus_wen && bus_adr[0] == 1'b0) && pls) |=> cnt == $past(cnt) - 8'd1);
assert property (@(posedge clk) disable iff (rst) (!(bus_wen && bus_adr[0] == 1'b0) && !pls) |=> $stable(cnt));
assert property (@(posedge clk) disable iff (rst) bus_wen |=> div == '0);
assert property (@(posedge clk) disable iff (rst) (!bus_wen && pls) |=> div == '0);
assert property (@(posedge clk) disable iff (rst) (!bus_wen && !pls) |=> div == $past(div) + $past(owr_cyc));
assert property (@(posedge clk) disable iff (rst) (bus_wen && bus_adr[0] == 1'b1) |=> cdr_n == $past(bus_wdt[15:0]));
assert property (@(posedge clk) disable iff (rst) (bus_wen && bus_adr[0] == 1'b1) |=> cdr_o == $past(bus_wdt[31:16]));
assert property (@(posedge clk) disable iff (rst) !(bus_wen && bus_adr[0] == 1'b1) |=> $stable(cdr_n) && $stable(cdr_o));
assert property (@(posedge clk) disable iff (rst) (bus_wen && bus_adr[0] == 1'b0) |=> owr_pwr == $past(bus_wdt[4]));
assert property (@(posedge clk) disable iff (rst) !(bus_wen && bus_adr[0] == 1'b0) |=> $stable(owr_pwr));
assert property (@(posedge clk) disable iff (rst) (pls && owr_rst && cnt == (owr_ovd ? 8'd38 : 8'd81)) |=> owr_smp == $past(owr_iln));
assert property (@(posedge clk) disable iff (rst) (pls && !owr_rst && cnt == (owr_ovd ? 8'd6 : 8'd10)) |=> owr_smp == $past(owr_iln));
assert property (@(posedge clk) disable iff (rst) (pls && !((owr_rst && cnt == (owr_ovd ? 8'd38 : 8'd81)) || (!owr_rst && cnt == (owr_ovd ? 8'd6 : 8'd10)))) |=> $stable(owr_smp));
assert property (@(posedge clk) disable iff (rst) !pls |=> $stable(owr_smp));
assert property (@(posedge clk) disable iff (rst) (bus_wen && bus_adr[0] == 1'b0) |=> owr_oen == $past(~&bus_wdt[1:0]));
assert property (@(posedge clk) disable iff (rst) (!(bus_wen && bus_adr[0] == 1'b0) && pls && owr_rst && cnt == (owr_ovd ? 8'd48 : 8'd96)) |=> !owr_oen);
assert property (@(posedge clk) disable iff (rst) (!(bus_wen && bus_adr[0] == 1'b0) && pls && !(owr_rst && cnt == (owr_ovd ? 8'd48 : 8'd96)) && owr_dat && cnt == (owr_ovd ? 8'd7 : 8'd12)) |=> !owr_oen);
assert property (@(posedge clk) disable iff (rst) (!(bus_wen && bus_adr[0] == 1'b0) && pls && !(owr_rst && cnt == (owr_ovd ? 8'd48 : 8'd96)) && !(owr_dat && cnt == (owr_ovd ? 8'd7 : 8'd12)) && cnt == (owr_ovd ? 8'd2 : 8'd1)) |=> !owr_oen);
assert property (@(posedge clk) disable iff (rst) (!(bus_wen && bus_adr[0] == 1'b0) && !(pls && ((owr_rst && cnt == (owr_ovd ? 8'd48 : 8'd96)) || (owr_dat && cnt == (owr_ovd ? 8'd7 : 8'd12)) || (cnt == (owr_ovd ? 8'd2 : 8'd1))))) |=> $stable(owr_oen));
